{
  "name": "budget-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@twind/core": "1.1.3",
    "@twind/preset-tailwind": "1.1.4",
    "@types/node": "^24.13.4",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "eslint": "10.11.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@twind/core": {
      "typescript": "$typescript"
    },
    "@twind/preset-tailwind": {
      "typescript": "$typescript"
    }
  }
}
